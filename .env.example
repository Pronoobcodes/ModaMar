# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# App
ENVIRONMENT=development
SECRET_KEY=change-me-super-secret
API_V1_PREFIX=/api/v1

# Database
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=naija_marketplace
DATABASE_URL=postgresql+asyncpg://marketplace:changeme@localhost:5432/naija_marketplace

# Redis (chat presence + Celery broker)
